<Window x:Class="Pods4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pods4 — Passthrough &amp; Noise Controls"
        Width="430" SizeToContent="Height" MaxHeight="780"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#11141B" Foreground="#F3F4F6"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1F29"/>
            <Setter Property="BorderBrush" Value="#283040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#131720"/>
            <Setter Property="BorderBrush" Value="#2B3345"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#222938"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AmbientModeButton" TargetType="RadioButton" BasedOn="{StaticResource ModeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1E2E2B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#059669"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#34D399"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="42" Height="23" CornerRadius="11.5"
                                Background="#334155" Padding="2">
                            <Ellipse x:Name="Thumb" Width="19" Height="19" Fill="#F8FAFC"
                                     HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#10B981"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Background" Value="#232B3A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#2E384D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DurRadio" TargetType="RadioButton" BasedOn="{StaticResource ModeButton}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,12,14,14">

            <!-- Device Header -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ConnDot" Width="9" Height="9" Fill="#F59E0B" Margin="0,0,7,0"/>
                                <TextBlock x:Name="DeviceNameText" Text="Searching for Galaxy Buds..."
                                           FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusSubText" Text="Connecting over Bluetooth RFCOMM..."
                                       Foreground="#94A3B8" FontSize="11.5" Margin="16,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="ReconnectBtn" Grid.Column="1" Content="Reconnect"
                                Style="{StaticResource SmallBtn}" VerticalAlignment="Center"
                                Click="ReconnectBtn_Click"/>
                    </Grid>

                    <!-- Battery & Wear Badges -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,11,0,0">
                        <Border Background="#131720" CornerRadius="8" Padding="8,6" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="LEFT" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="BatLeftText" Text="—" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WearLeftText" Text="—" Foreground="#94A3B8" FontSize="10.5"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#131720" CornerRadius="8" Padding="8,6" Margin="2,0">
                            <StackPanel>
                                <TextBlock Text="RIGHT" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="BatRightText" Text="—" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WearRightText" Text="—" Foreground="#94A3B8" FontSize="10.5"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#131720" CornerRadius="8" Padding="8,6" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="CASE" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="BatCaseText" Text="—" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CaseSubText" Text="—" Foreground="#94A3B8" FontSize="10.5"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Controls Panel (disabled until connected) -->
            <StackPanel x:Name="ControlsRoot" IsEnabled="False">

                <!-- Noise Control Mode -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="NOISE CONTROLS" Foreground="#94A3B8" FontSize="11"
                                   FontWeight="Bold" Margin="0,0,0,10"/>
                        <UniformGrid Columns="4">
                            <RadioButton x:Name="ModeOffBtn" GroupName="NcMode" Content="Off"
                                         Style="{StaticResource ModeButton}" Margin="0,0,4,0"
                                         Checked="ModeBtn_Checked"/>
                            <RadioButton x:Name="ModeAncBtn" GroupName="NcMode" Content="ANC"
                                         Style="{StaticResource ModeButton}" Margin="2,0"
                                         Checked="ModeBtn_Checked"/>
                            <RadioButton x:Name="ModeAmbientBtn" GroupName="NcMode" Content="Ambient"
                                         Style="{StaticResource AmbientModeButton}" Margin="2,0"
                                         Checked="ModeBtn_Checked"/>
                            <RadioButton x:Name="ModeAdaptiveBtn" GroupName="NcMode" Content="Adaptive"
                                         Style="{StaticResource ModeButton}" Margin="4,0,0,0"
                                         Checked="ModeBtn_Checked"/>
                        </UniformGrid>
                        <TextBlock x:Name="OneBudHintText" Visibility="Collapsed"
                                   Text="Tip: Only 1 earbud is in ear — enable 'Noise controls with one earbud' below to use ANC/Adaptive with one bud."
                                   TextWrapping="Wrap" Foreground="#FBBF24" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ambient / Passthrough & ANC Levels -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="PASSTHROUGH &amp; ANC LEVELS" Foreground="#94A3B8" FontSize="11"
                                   FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- Ambient Sound Volume -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Ambient Sound Volume (Passthrough)" FontSize="13"/>
                            <TextBlock x:Name="AmbientVolLabel" Text="Level 3" Foreground="#34D399"
                                       FontWeight="SemiBold" FontSize="12.5" DockPanel.Dock="Right"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="AmbientVolSlider" Minimum="0" Maximum="4" TickFrequency="1"
                                IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                Margin="0,0,0,12" ValueChanged="AmbientVolSlider_ValueChanged"/>

                        <!-- ANC Strength -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Active Noise Cancelling Level" FontSize="13"/>
                            <TextBlock x:Name="AncLevelLabel" Text="Level 5" Foreground="#60A5FA"
                                       FontWeight="SemiBold" FontSize="12.5" DockPanel.Dock="Right"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="AncLevelSlider" Minimum="0" Maximum="4" TickFrequency="1"
                                IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                ValueChanged="AncLevelSlider_ValueChanged"/>
                    </StackPanel>
                </Border>

                <!-- Customize Ambient Sound (L/R + Tone) -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Customize Ambient Sound" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock Text="Per-ear passthrough boost &amp; sound tone"
                                           Foreground="#94A3B8" FontSize="11.5"/>
                            </StackPanel>
                            <CheckBox x:Name="CustomAmbientToggle" Style="{StaticResource PillToggle}"
                                      DockPanel.Dock="Right" HorizontalAlignment="Right"
                                      Click="CustomAmbient_Changed"/>
                        </DockPanel>

                        <StackPanel x:Name="CustomAmbientPanel" Margin="0,8,0,0" IsEnabled="False" Opacity="0.55">
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Left Ear Boost" FontSize="12.5" Foreground="#CBD5E1"/>
                                <TextBlock x:Name="CustomLeftLabel" Text="Normal" Foreground="#34D399"
                                           FontSize="12" FontWeight="SemiBold" DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider x:Name="CustomLeftSlider" Minimum="0" Maximum="2" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Margin="0,0,0,8"
                                    ValueChanged="CustomAmbient_SliderChanged"/>

                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Right Ear Boost" FontSize="12.5" Foreground="#CBD5E1"/>
                                <TextBlock x:Name="CustomRightLabel" Text="Normal" Foreground="#34D399"
                                           FontSize="12" FontWeight="SemiBold" DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider x:Name="CustomRightSlider" Minimum="0" Maximum="2" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Margin="0,0,0,8"
                                    ValueChanged="CustomAmbient_SliderChanged"/>

                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Ambient Tone (Soft ↔ Clear)" FontSize="12.5" Foreground="#CBD5E1"/>
                                <TextBlock x:Name="CustomToneLabel" Text="Neutral" Foreground="#34D399"
                                           FontSize="12" FontWeight="SemiBold" DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider x:Name="CustomToneSlider" Minimum="0" Maximum="4" TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="CustomAmbient_SliderChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Smart Auto-Passthrough & Call Options -->
                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="AUTO SWITCH &amp; PASSTHROUGH OPTIONS" Foreground="#94A3B8"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- Voice Detect -->
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Voice Detect" FontSize="13"/>
                                <TextBlock Text="Auto-switch to Ambient Sound when you speak"
                                           Foreground="#94A3B8" FontSize="11"/>
                            </StackPanel>
                            <CheckBox x:Name="VoiceDetectToggle" Style="{StaticResource PillToggle}"
                                      DockPanel.Dock="Right" HorizontalAlignment="Right"
                                      Click="VoiceDetectToggle_Click"/>
                        </DockPanel>

                        <UniformGrid x:Name="VoiceDurPanel" Columns="3" Margin="0,0,0,12" IsEnabled="False">
                            <RadioButton x:Name="Dur5Btn" GroupName="VoiceDur" Content="5 sec"
                                         Style="{StaticResource DurRadio}" Margin="0,0,4,0"
                                         Checked="VoiceDur_Checked"/>
                            <RadioButton x:Name="Dur10Btn" GroupName="VoiceDur" Content="10 sec"
                                         Style="{StaticResource DurRadio}" Margin="2,0"
                                         Checked="VoiceDur_Checked"/>
                            <RadioButton x:Name="Dur15Btn" GroupName="VoiceDur" Content="15 sec"
                                         Style="{StaticResource DurRadio}" Margin="4,0,0,0"
                                         Checked="VoiceDur_Checked"/>
                        </UniformGrid>

                        <!-- Siren Detect -->
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Siren Detect" FontSize="13"/>
                                <TextBlock Text="Auto-switch to Ambient Sound on alarms &amp; sirens"
                                           Foreground="#94A3B8" FontSize="11"/>
                            </StackPanel>
                            <CheckBox x:Name="SirenDetectToggle" Style="{StaticResource PillToggle}"
                                      DockPanel.Dock="Right" HorizontalAlignment="Right"
                                      Click="SirenDetectToggle_Click"/>
                        </DockPanel>

                        <!-- Ambient during calls (Sidetone) -->
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Ambient Sound During Calls" FontSize="13"/>
                                <TextBlock Text="Hear your own voice naturally during calls"
                                           Foreground="#94A3B8" FontSize="11"/>
                            </StackPanel>
                            <CheckBox x:Name="SidetoneToggle" Style="{StaticResource PillToggle}"
                                      DockPanel.Dock="Right" HorizontalAlignment="Right"
                                      Click="SidetoneToggle_Click"/>
                        </DockPanel>

                        <!-- Noise controls with one earbud -->
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="Noise Controls with One Earbud" FontSize="13"/>
                                <TextBlock Text="Allow ANC &amp; Adaptive while wearing only one bud"
                                           Foreground="#94A3B8" FontSize="11"/>
                            </StackPanel>
                            <CheckBox x:Name="OneBudToggle" Style="{StaticResource PillToggle}"
                                      DockPanel.Dock="Right" HorizontalAlignment="Right"
                                      Click="OneBudToggle_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
